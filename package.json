{
  "name": "audio-margin",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run assets && npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "assets": "node scripts/optimize-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "playwright-core": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
