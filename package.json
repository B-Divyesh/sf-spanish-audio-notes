{
  "name": "audio-margin",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run assets && npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "assets": "node scripts/optimize-assets.mjs",
    "test": "vitest run",
    "test:claims": "playwright test --grep @claim && vitest run -t @claim && npm run test:installers && npm run test:native-integrity && npm run test:native-transcription && npm run test:claim:appimage",
    "test:installers": "node scripts/test-installers.mjs",
    "test:native-integrity": "cargo test --manifest-path src-tauri/Cargo.toml claim_model_integrity -- --nocapture",
    "test:native-transcription": "node scripts/run-native-transcription-claim.mjs",
    "test:appimage": "sh scripts/test-appimage-audio.sh",
    "test:claim:appimage": "CI=true npm run tauri build -- --bundles appimage && npm run test:appimage",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "playwright-core": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
