{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Margin",
  "version": "0.1.3",
  "identifier": "in.sociobot.spanish-audio-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{ "title": "Audio Margin", "width": 1280, "height": 820, "minWidth": 390, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src 'self' https://api.sociobot.in https://huggingface.co; style-src 'self' 'unsafe-inline'", "assetProtocol": { "enable": true, "scope": ["$AUDIO/**", "$VIDEO/**", "$DOWNLOAD/**", "$DESKTOP/**", "$DOCUMENT/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Private, time-linked Spanish audio notes",
    "longDescription": "Transcribe Spanish audio locally, pin your own questions to exact moments, and review a bounded set of five.",
    "copyright": "Copyright © 2026 Param Factory",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "10.15" },
    "linux": { "deb": { "depends": [] } }
  }
}
